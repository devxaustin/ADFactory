---
// One product on the line, shown as a carousel slide. The same component renders at three
// levels of finish: sketched (prototype), under construction (production), lit solid (shipped).
// Kept deliberately light: a meta line, the title, a short summary, and at most one button.
// Tags and extra links live on the project's own file page.
interface Props {
  id: string;
  title: string;
  summary: string;
  stage: 'prototype' | 'production' | 'shipped';
  type: string;
  year: number;
  progress?: number;
  links?: { label: string; href: string }[];
  image?: string;
}

const { id, title, summary, stage, type, year, progress = 0, links = [], image } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const href = `${base}projects/${id}/`;
const stageName = { prototype: 'Prototype', production: 'In production', shipped: 'Shipped' }[stage];
const SEGMENTS = 10;
const filled = Math.round((progress / 100) * SEGMENTS);

// A link starting with "/" is a path on this site, so it gets the site's base path.
const primary = links[0] && {
  label: links[0].label,
  href: links[0].href.startsWith('/') ? `${base}${links[0].href.slice(1)}` : links[0].href,
};
---

<li class="slide">
  <article class="card" data-stage={stage}>
    <p class="meta-line">{stageName} / {type} / {year}</p>
    <h3><a class="card-link" href={href}>{title}</a></h3>
    {image && <img class="cover" src={`${base}${image.replace(/^\//, '')}`} alt="" />}
    <p class="summary">{summary}</p>

    {
      stage === 'production' && (
        <div class="meter" role="img" aria-label={`${progress} percent complete`}>
          {Array.from({ length: SEGMENTS }, (_, i) => (
            <span class:list={['seg', { on: i < filled }]} />
          ))}
          <span class="pct">{progress}%</span>
        </div>
      )
    }

    {
      primary && (
        <div class="actions">
          <a class="btn" href={primary.href} target="_blank" rel="noopener noreferrer">
            {primary.label}
          </a>
        </div>
      )
    }
  </article>
</li>
