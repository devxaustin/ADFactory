---
import '@fontsource-variable/archivo/wdth.css';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Austin Devereux Jr.',
  description = 'Projects, art, and music from Austin Devereux Jr., arranged by how finished they are.',
} = Astro.props;

const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1d2023" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="bar">
      <div class="page">
        <a href={base}>Austin Devereux Jr.</a>
        <nav aria-label="Stations">
          <a href={`${base}#prototype`}>Prototypes</a>
          <a href={`${base}#production`}>In production</a>
          <a href={`${base}#shipped`}>Shipped</a>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="foot">
      <div class="page">
        <span>Austin Devereux Jr.</span>
        <a href="https://github.com/devxaustin">github.com/devxaustin</a>
      </div>
    </footer>
  </body>
</html>
