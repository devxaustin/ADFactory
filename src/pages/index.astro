---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';

const all = (await getCollection('projects'))
  .filter((p) => !p.data.hidden)
  .sort((a, b) => a.data.year - b.data.year || a.data.title.localeCompare(b.data.title));

// Serial numbers follow production order across the whole line.
const items = all.map((entry, i) => ({ entry, serial: i + 1 }));

const stations = [
  {
    key: 'prototype',
    name: 'Prototypes',
    blurb: 'Early builds and open questions. Rough edges are part of it.',
  },
  {
    key: 'production',
    name: 'In production',
    blurb: 'Working, but not done. The meter shows how far along each one is.',
  },
  {
    key: 'shipped',
    name: 'Shipped',
    blurb: 'Finished work, ready to look at, play, or listen to.',
  },
] as const;

const byStage = (key: string) => items.filter(({ entry }) => entry.data.stage === key);
---

<Base>
  <section class="hero page" aria-labelledby="name">
    <h1 id="name" class="name">Austin Devereux Jr.</h1>
    <p class="lede">
      Software, art, and music, laid out by how finished each piece is. Start at the prototypes and
      follow the line to what has shipped.
    </p>

    <ol class="counts">
      {
        stations.map((s, i) => (
          <li class="count" data-stage={s.key} style={`--i:${i}`}>
            <a href={`#${s.key}`}>
              <span class="n">{byStage(s.key).length}</span>
              <span class="what label">{s.name}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </section>

  {
    stations.map((s, i) => (
      <>
        <div class="conveyor" aria-hidden="true" />
        <section class="station page" id={s.key} aria-labelledby={`${s.key}-h`}>
          <header class="station-head">
            <h2 id={`${s.key}-h`}>
              <span class="label step">Station {i + 1}</span>
              {s.name}
            </h2>
            <p>{s.blurb}</p>
          </header>

          {byStage(s.key).length > 0 ? (
            <div class="grid">
              {byStage(s.key).map(({ entry, serial }) => (
                <ProjectCard
                  id={entry.id}
                  title={entry.data.title}
                  summary={entry.data.summary}
                  stage={entry.data.stage}
                  type={entry.data.type}
                  year={entry.data.year}
                  progress={entry.data.progress}
                  tags={entry.data.tags}
                  serial={serial}
                />
              ))}
            </div>
          ) : (
            <p class="empty">
              Nothing here yet. Add a file to <code>src/content/projects</code> with{' '}
              <code>stage: {s.key}</code> and it shows up on this station.
            </p>
          )}
        </section>
      </>
    ))
  }
</Base>

<style>
  .hero {
    padding-block: clamp(2.5rem, 7vw, 6rem) clamp(2rem, 5vw, 4rem);
  }
  .name {
    font-size: var(--step-hero);
    line-height: 0.9;
    max-width: 14ch;
    text-wrap: balance;
  }
  .lede {
    margin-top: 1.75rem;
    max-width: var(--measure);
    font-size: var(--step-1);
    line-height: 1.4;
  }

  /* Hero counters: the three stations, drawn at three levels of finish */
  .counts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: var(--gap);
    margin: clamp(2rem, 5vw, 3.5rem) 0 0;
    padding: 0;
    list-style: none;
  }
  .count a {
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 11rem;
    padding: 1.1rem 1.25rem;
    text-decoration: none;
  }
  .n {
    font-size: clamp(4rem, 9vw, 7rem);
    line-height: 0.85;
    font-weight: 900;
    font-variation-settings: 'wdth' var(--wdth-display);
  }
  .what {
    font-size: var(--step-1);
  }
  .count[data-stage='prototype'] a {
    border: var(--line-thin) dashed var(--blueprint);
    color: var(--blueprint);
    background-color: var(--slab);
    background-image:
      linear-gradient(rgba(35, 64, 240, 0.16) 1px, transparent 1px),
      linear-gradient(90deg, rgba(35, 64, 240, 0.16) 1px, transparent 1px);
    background-size: 1.25rem 1.25rem;
  }
  .count[data-stage='production'] a {
    border: var(--line) solid var(--steel);
    border-top: 1.1rem solid var(--hazard);
    background: var(--slab);
  }
  .count[data-stage='shipped'] a {
    border: var(--line) solid var(--steel);
    background: var(--steel);
    color: var(--slab);
    box-shadow: var(--offset) var(--offset) 0 var(--hazard);
  }

  /* The one load-in: each counter is carried onto the line in hard steps */
  .count {
    animation: carry 700ms steps(7, end) both;
    animation-delay: calc(var(--i) * 220ms);
  }
  @keyframes carry {
    from {
      transform: translateX(-110%);
      opacity: 0;
    }
    to {
      transform: translateX(0);
      opacity: 1;
    }
  }

  .station {
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
  }
  .station-head {
    display: grid;
    gap: 0.9rem;
    margin-bottom: 2.25rem;
    max-width: var(--measure);
  }
  .station-head h2 {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    font-size: clamp(2.1rem, 5.5vw, 4rem);
  }
  .step {
    font-size: var(--step-0);
    font-weight: 650;
    letter-spacing: 0.02em;
    font-variation-settings: 'wdth' var(--wdth-label);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
    gap: calc(var(--gap) * 1.4);
    /* room for the offset shadow on shipped cards */
    padding: 0 var(--offset) var(--offset) 0;
  }

  .empty {
    max-width: var(--measure);
    padding: 1.25rem;
    border: var(--line-thin) dashed var(--steel);
  }
  code {
    font-family: inherit;
    font-weight: 800;
    background: var(--slab);
    padding: 0 0.3em;
  }
</style>
