---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectSlide from '../components/ProjectSlide.astro';
import ModelStage from '../components/ModelStage.astro';
import { site, channels, menuModels } from '../data/site';

// The line runs prototype -> production -> shipped, oldest first within each station.
const stageOrder = { prototype: 0, production: 1, shipped: 2 } as const;
const items = (await getCollection('projects'))
  .filter((p) => !p.data.hidden)
  .sort(
    (a, b) =>
      stageOrder[a.data.stage] - stageOrder[b.data.stage] ||
      a.data.year - b.data.year ||
      a.data.title.localeCompare(b.data.title),
  );

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

// Menu models with any .glb file turned into a URL under the site's base path.
const menuStage = Object.fromEntries(
  Object.entries(menuModels).map(([k, m]) => [k, { kind: m.kind, file: m.file ? `${base}models/${m.file}` : undefined, rotate: m.rotate, tint: m.tint, textures: m.textures ? `${base}models/${m.textures}` : undefined }]),
);
const pad = (n: number) => String(n).padStart(2, '0');

const menu = [
  { key: 'about', label: 'About' },
  { key: 'projects', label: 'Projects' },
  { key: 'media', label: 'Media' },
  { key: 'contact', label: 'Contact' },
] as const;
---

<Base>
  <!-- MENU: the built-in control menu. This is the home screen. -->
  <section class="pane" data-pane="menu" aria-labelledby="menu-h" hidden>
    <div class="menu">
      <div class="menu-stage" aria-hidden="true" data-models={JSON.stringify(menuStage)}>
        <canvas></canvas>
        <i class="menu-shadow"></i>
      </div>
      <div class="menu-hero">
        <p class="kicker">AD Factory TV</p>
        <h1 id="menu-h">{site.name}</h1>
        <p class="lede">{site.about.headline}</p>
        <div class="status">
          <span>Signal: locked</span>
          <span>Stations: prototype, production, shipped</span>
        </div>
      </div>

      <div>
        <ul class="menu-list" role="list">
          {
            menu.map((m) => (
              <li>
                <a class="menu-row" href={`${base}#${m.key}`} data-nav={m.key}>
                  {m.label}
                </a>
              </li>
            ))
          }
        </ul>
        <p class="legend">
          <span class="k-desk">
            Select: <i class="tri up"></i><i class="tri down"></i> key &nbsp; Set: <i
              class="tri right"></i> key &nbsp; End: esc key
          </span>
          <span class="k-touch">Tap a line to open it</span>
        </p>
      </div>
    </div>
  </section>

  <!-- ABOUT -->
  <section class="pane" data-pane="about" aria-labelledby="about-h" hidden>
    <div class="split">
      <div class="text-screen">
        <p class="prompt">&gt; LOAD AD_FACTORY.SYS</p>
        <h1 id="about-h">{site.name}</h1>
        <p class="lede">{site.about.headline}</p>
        {site.about.paragraphs.map((p) => <p>{p}</p>)}
        <p class="prompt">&gt; <i class="cursor"></i></p>
      </div>
      <aside class="side">
        <ModelStage kind={site.about.model.kind} tag={site.about.model.tag} label={site.about.model.label} file={site.about.model.file} />
        <ul class="spec">
          {
            site.about.spec.map(([k, v]) => (
              <li>
                <span>{k}</span>
                {v}
              </li>
            ))
          }
        </ul>
      </aside>
    </div>
  </section>

  <!-- PROJECTS: left/right carousel -->
  <section class="pane" data-pane="projects" aria-labelledby="projects-h" hidden>
    <header class="pane-head">
      <h2 id="projects-h">Projects</h2>
      <span class="meta">Prototype to shipped</span>
    </header>

    {
      items.length > 0 ? (
        <>
          <ul class="track" role="list" aria-label="Projects, swipe or use the arrows">
            {items.map((entry, i) => (
              <ProjectSlide
                id={entry.id}
                title={entry.data.title}
                summary={entry.data.summary}
                stage={entry.data.stage}
                type={entry.data.type}
                year={entry.data.year}
                progress={entry.data.progress}
                tags={entry.data.tags}
                links={entry.data.links}
                image={entry.data.image}
                serial={i + 1}
              />
            ))}
          </ul>
          <div class="deck-controls">
            <button class="btn arrow" type="button" data-deck-prev aria-label="Previous project">
              <i class="tri left" />
            </button>
            <span class="deck-count" data-deck-count aria-live="polite">
              01 / {pad(items.length)}
            </span>
            <button class="btn arrow" type="button" data-deck-next aria-label="Next project">
              <i class="tri right" />
            </button>
          </div>
        </>
      ) : (
        <p class="text-screen">
          Nothing on the line yet. Add a file to <code>src/content/projects</code>.
        </p>
      )
    }
  </section>

  <!-- MEDIA: a TV -->
  <section class="pane" data-pane="media" aria-labelledby="media-h" hidden>
    <header class="pane-head">
      <h2 id="media-h">Media</h2>
      <span class="meta">Change the channel</span>
    </header>

    <div class="tv">
      <div class="tv-main">
        <div class="tv-screen">
          <iframe
            title="TV"
            src="about:blank"
            allow="autoplay; encrypted-media; picture-in-picture; fullscreen"
            allowfullscreen
            referrerpolicy="strict-origin-when-cross-origin"></iframe>
          <canvas class="tv-static"></canvas>
          <div class="tv-catch" aria-hidden="true"></div>
          <div class="tv-osd" aria-hidden="true"><span class="ch"></span><span class="t"></span></div>
        </div>

        <div class="tv-readout">
          <button class="btn" type="button" data-tv-step="-1" aria-label="Channel down">CH -</button>
          <span class="tv-ch" data-tv-ch aria-live="polite">CH 01 / {pad(channels.length)}</span>
          <button class="btn" type="button" data-tv-step="1" aria-label="Channel up">CH +</button>
        </div>
        <p class="tv-title" data-tv-title>{channels[0]?.title}</p>

        <div class="tv-deck" role="group" aria-label="Playback controls">
          <button class="btn sm" type="button" data-yt-play aria-label="Play">Play</button>
          <input class="rng seek" type="range" min="0" max="1000" value="0" step="1" data-yt-seek aria-label="Seek" />
          <span class="tv-time" data-yt-time>0:00 / 0:00</span>
          <button class="btn sm" type="button" data-yt-mute aria-label="Mute">Vol</button>
          <input class="rng vol" type="range" min="0" max="100" value="100" step="1" data-yt-vol aria-label="Volume" />
        </div>
      </div>

      <div class="tv-side">
        <h3>Channel guide</h3>
        <ul class="tv-guide" aria-label="Channels">
          {
            channels.map((c, i) => (
              <li>
                <button
                  class="btn sm"
                  type="button"
                  data-yt={c.youtube}
                  data-title={c.title}
                  aria-label={`Channel ${i + 1}: ${c.title}`}
                >
                  <span class="gn">{pad(i + 1)}</span>
                  <span class="gt">{c.title}</span>
                </button>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section class="pane" data-pane="contact" aria-labelledby="contact-h" hidden>
    <div class="split">
      <div class="text-screen">
        <p class="prompt">&gt; OPEN CHANNEL</p>
        <h2 id="contact-h">Contact</h2>
        <p class="lede">{site.contact.intro}</p>
        <ul class="links">
          {
            site.contact.links.map((l) => (
              <li>
                <a
                  href={l.href}
                  target={l.href.startsWith('mailto:') ? undefined : '_blank'}
                  rel="noopener noreferrer"
                >
                  <span>{l.label}</span>
                  {l.text}
                </a>
              </li>
            ))
          }
        </ul>
        <p class="prompt">&gt; <i class="cursor"></i></p>
      </div>
      <aside class="side">
        <ModelStage kind={site.contact.model.kind} tag={site.contact.model.tag} label={site.contact.model.label} file={site.contact.model.file} />
      </aside>
    </div>
  </section>
</Base>

<script>
  import '../scripts/router.ts';
  import '../scripts/models.ts';
  import '../scripts/menu.ts';
  import '../scripts/carousel.ts';
  import '../scripts/tv.ts';
</script>
