---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ModelStage from '../components/ModelStage.astro';
import { site, channels, menuModels, projectCategories } from '../data/site';

// The line runs prototype -> production -> shipped, oldest first within each station.
const stageOrder = { prototype: 0, production: 1, shipped: 2 } as const;
const items = (await getCollection('projects'))
  .filter((p) => !p.data.hidden)
  .sort(
    (a, b) =>
      stageOrder[a.data.stage] - stageOrder[b.data.stage] ||
      a.data.year - b.data.year ||
      a.data.title.localeCompare(b.data.title),
  );

const counts = {
  prototype: items.filter((p) => p.data.stage === 'prototype').length,
  production: items.filter((p) => p.data.stage === 'production').length,
  shipped: items.filter((p) => p.data.stage === 'shipped').length,
};
const outCells = [
  { key: 'prototype', label: 'Prototypes', look: 'Wireframe' },
  { key: 'production', label: 'In production', look: 'Cast' },
  { key: 'shipped', label: 'Shipped', look: 'Polished' },
] as const;

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

// Menu models with any .glb file turned into a URL under the site's base path.
const menuStage = Object.fromEntries(
  Object.entries(menuModels).map(([k, m]) => [k, { kind: m.kind, file: m.file ? `${base}models/${m.file}` : undefined, rotate: m.rotate, tint: m.tint, textures: m.textures ? `${base}models/${m.textures}` : undefined }]),
);
const pad = (n: number) => String(n).padStart(2, '0');

// Projects screen: each category with its projects, and the 3D model each one shows.
const cats = projectCategories.map((c) => ({ ...c, items: items.filter((p) => p.data.category === c.key) }));
const projModels = Object.fromEntries(
  projectCategories.map((c) => [
    c.key,
    { kind: c.model.kind, file: c.model.file ? `${base}models/${c.model.file}` : undefined, rotate: c.model.rotate, tint: c.model.tint, textures: c.model.textures ? `${base}models/${c.model.textures}` : undefined, accent: c.accent, sway: c.model.sway },
  ]),
);
const rgb = (h: string) => {
  const n = parseInt(h.slice(1), 16);
  return `${n >> 16} ${(n >> 8) & 255} ${n & 255}`;
};
const stageName = { prototype: 'Prototype', production: 'In production', shipped: 'Shipped' } as const;
const stageColor = { prototype: 'var(--c-cyan)', production: 'var(--c-amber)', shipped: 'var(--c-lime)' } as const;
const first = cats[0];
const href = (h: string) => (h.startsWith('/') ? `${base}${h.slice(1)}` : h);

const menu = [
  { key: 'about', label: 'About' },
  { key: 'projects', label: 'Projects' },
  { key: 'media', label: 'Media' },
  { key: 'contact', label: 'Contact' },
] as const;
---

<Base>
  <!-- MENU: the built-in control menu. This is the home screen. -->
  <section class="pane" data-pane="menu" aria-labelledby="menu-h" hidden>
    <div class="menu">
      <div class="menu-stage" aria-hidden="true" data-swipe="stage" data-models={JSON.stringify(menuStage)}>
        <canvas></canvas>
        <i class="menu-shadow"></i>
      </div>
      <div class="menu-hero">
        <p class="kicker">AD Factory TV</p>
        <h1 id="menu-h">{site.name}</h1>
        <p class="lede">{site.about.headline}</p>
        <div class="status">
          <span>Signal: locked</span>
          <span>Stations: prototype, production, shipped</span>
        </div>
      </div>

      <div>
        <!-- Phones: the object is the button. This names the one on screen (the list below is then for keyboards and screen readers). -->
        <div class="menu-pick" aria-hidden="true">
          <b data-menu-name>{menu[0].label}</b>
          <span class="pick-dots">{menu.map((m, i) => <i data-menu-dot={m.key} class:list={{ on: i === 0 }}></i>)}</span>
        </div>
        <ul class="menu-list" role="list">
          {
            menu.map((m) => (
              <li>
                <a class="menu-row" href={`${base}#${m.key}`} data-nav={m.key}>
                  {m.label}
                </a>
              </li>
            ))
          }
        </ul>
        <p class="legend">
          <span class="k-desk">
            Select: <i class="tri up"></i><i class="tri down"></i> key &nbsp; Set: <i
              class="tri right"></i> key &nbsp; End: esc key
          </span>
          <span class="k-touch">Tap the object to open it. Swipe it to browse.</span>
        </p>
      </div>
    </div>
  </section>

  <!-- INTRO: concept -> in production -> shipped. Plays once per visit (see src/scripts/intro.ts). -->
  <div class="intro-screen" id="intro" data-act="1" aria-hidden="true">
    <div class="intro-bg bg1"><span class="blue-title"><b>Proto 001</b><i>AD monogram / rev 0.1</i></span></div>
    <div class="intro-bg bg2">
      <i class="beacon l"></i><i class="beacon r"></i><i class="redwash"></i>
      <i class="tape a"></i><i class="tape b"></i>
    </div>
    <canvas class="intro-gl" id="intro-gl"></canvas>
    <canvas class="crt-static intro-static" id="intro-static"></canvas>
    <p class="intro-cap" id="intro-cap"></p>
    <button class="intro-skip" id="intro-skip" type="button">Skip &#9656;</button>
  </div>

  <!-- ABOUT -->
  <section class="pane" data-pane="about" aria-labelledby="about-h" hidden>
    <button type="button" class="btn sm reboot" data-reboot>Reboot</button>
    <div class="split">
      <div class="text-screen">
        <ul class="boot-log" aria-hidden="true"></ul>
        <p class="prompt bt" data-type>&gt; LOAD AD_FACTORY.SYS</p>
        <h1 id="about-h" class="bt">{site.name}</h1>
        <p class="lede bt">{site.about.headline}</p>
        {site.about.paragraphs.map((p) => <p class:list={['bt', { 'desk-only': /^Press Esc/.test(p) }]}>{p}</p>)}
        <p class="prompt bt">&gt; <i class="cursor"></i></p>
      </div>
      <aside class="side">
        <ModelStage kind={site.about.model.kind} tag={site.about.model.tag} label={site.about.model.label} file={site.about.model.file}>
        </ModelStage>
        <div class="output" role="group" aria-label="Factory output. Choose a stage to see the logo at that finish.">
          <p class="output-h">Factory output</p>
          <div class="output-cells">
            {
              outCells.map((c, i) => (
                <button type="button" class="out-cell" data-look={i} data-count={counts[c.key]} data-key={c.key} aria-label={`${counts[c.key]} ${c.label.toLowerCase()}. Show the logo as ${c.look.toLowerCase()}.`}>
                  <span class="odo" aria-hidden="true" />
                  <b>{c.label}</b>
                  <i>{c.look}</i>
                </button>
              ))
            }
          </div>
        </div>
      </aside>
    </div>
  </section>

  <!-- PROJECTS: categories with a floating 3D model. Opening one slides the model aside and shows its projects. -->
  <section
    class="pane pj"
    data-pane="projects"
    data-level="browse"
    data-cat={first?.key}
    aria-labelledby="projects-h"
    hidden
  >
    <header class="pane-head">
      <h2 id="projects-h">Projects</h2>
      <p class="crumb">
        <button class="btn sm" type="button" data-proj-back hidden><i class="tri left"></i> Back</button>
        <span data-crumb>Pick a line</span>
      </p>
    </header>

    {
      cats.length > 0 ? (
        <div class="proj">
          <div class="proj-stage" aria-hidden="true" data-swipe="stage" data-models={JSON.stringify(projModels)}>
            <div class="proj-orb">
              <i class="rays" />
              <i class="ring" />
              <i class="body" />
              <i class="pulse" />
            </div>
            <canvas />
          </div>

          <ul class="proj-cats" role="list" aria-label="Project categories">
            <li class="hl" aria-hidden="true" />
            {cats.map((c, i) => (
              <li style={`--i:${i}`}>
                <button
                  type="button"
                  class:list={['proj-row', { 'is-sel': i === 0 }]}
                  data-cat={c.key}
                  data-label={c.label}
                  data-accent={c.accent}
                  data-accent2={c.accent2}
                  data-on={c.onAccent}
                  data-bg-a={c.bg[0]}
                  data-bg-b={c.bg[1]}
                  data-theme={c.theme}
                  style={`--chip:${c.accent}`}
                >
                  <i class="chip" />
                  <span class="t">{c.label}</span>
                  <span class="count">{pad(c.items.length)}</span>
                </button>
              </li>
            ))}
          </ul>

          <div class="proj-pick" aria-hidden="true">
            <b data-proj-name>{first?.label}</b>
            <span class="pick-dots">{cats.map((c) => <i data-proj-dot={c.key} class:list={{ on: c === first }} />)}</span>
          </div>

          {cats.map((c) => (
            <div class="proj-view" data-view={c.key}>
              {c.items.length > 0 ? (
                <>
                  <ul class="proj-glist" role="list" aria-label={`${c.label} projects`}>
                    <li class="hl" aria-hidden="true" />
                    {c.items.map((p, i) => (
                      <li style={`--i:${i}`}>
                        <button type="button" class:list={['proj-row', { 'is-sel': i === 0 }]} data-game={p.id} style={`--chip:${stageColor[p.data.stage]}`}>
                          <i class="chip" />
                          <span class="t">{p.data.title}</span>
                        </button>
                      </li>
                    ))}
                  </ul>
                  <div class="proj-details" aria-live="polite">
                    {c.items.map((p, i) => {
                      const filled = Math.round(((p.data.progress ?? 0) / 100) * 10);
                      return (
                        <article class:list={['proj-detail', { 'is-on': i === 0 }]} data-stage={p.data.stage} data-game={p.id}>
                          <span class="badge">{stageName[p.data.stage]}</span>
                          <h3>{p.data.title}</h3>
                          <p class="meta-line">
                            {p.data.type} / {p.data.year}
                          </p>
                          {p.data.image && <img class="cover" src={`${base}${p.data.image.replace(/^\//, '')}`} alt="" />}
                          <p class="summary">{p.data.summary}</p>
                          {p.data.stage === 'production' && (
                            <div class="meter" role="img" aria-label={`${p.data.progress ?? 0} percent complete`}>
                              {Array.from({ length: 10 }, (_, n) => (
                                <span class:list={['seg', { on: n < filled }]} style={`--n:${n}`} />
                              ))}
                              <span class="pct">{p.data.progress ?? 0}%</span>
                            </div>
                          )}
                          <div class="actions">
                            {p.data.links[0] && (
                              <a class="btn primary" href={href(p.data.links[0].href)} target="_blank" rel="noopener noreferrer">
                                {p.data.links[0].label}
                              </a>
                            )}
                            <a class="btn" href={`${base}projects/${p.id}/`}>
                              Open file
                            </a>
                          </div>
                        </article>
                      );
                    })}
                  </div>
                </>
              ) : (
                <p class="proj-empty">Nothing here yet.</p>
              )}
            </div>
          ))}

          <p class="legend proj-legend">
            <span class="k-desk">
              <span data-when="browse">
                Select: click or <i class="tri up" />
                <i class="tri down" /> key &nbsp; Open: click or <i class="tri right" /> key &nbsp; End: esc key
              </span>
              <span data-when="open">
                Select: <i class="tri up" />
                <i class="tri down" /> key &nbsp; Go: enter key &nbsp; Back: <i class="tri left" /> key
              </span>
            </span>
            <span class="k-touch">
              <span data-when="browse">Tap the object to open it. Swipe it to browse.</span>
              <span data-when="open">Swipe right to go back.</span>
            </span>
          </p>
        </div>
      ) : (
        <p class="text-screen">
          No categories yet. Add one in <code>projectCategories</code> in <code>src/data/site.ts</code>.
        </p>
      )
    }
  </section>

  <!-- MEDIA: a TV -->
  <section class="pane" data-pane="media" aria-labelledby="media-h" hidden>
    <header class="pane-head">
      <h2 id="media-h">Media</h2>
      <span class="meta">Change the channel</span>
    </header>

    <div class="tv">
      <div class="tv-main">
        <div class="tv-screen" data-swipe="tv">
          <iframe
            title="TV"
            src="about:blank"
            allow="autoplay; encrypted-media; picture-in-picture; fullscreen"
            allowfullscreen
            referrerpolicy="strict-origin-when-cross-origin"></iframe>
          <canvas class="tv-static"></canvas>
          <div class="tv-catch" aria-hidden="true"></div>
          <div class="tv-osd" aria-hidden="true"><span class="ch"></span><span class="t"></span></div>
        </div>

        <div class="tv-readout">
          <button class="btn" type="button" data-tv-step="-1" aria-label="Channel down">CH -</button>
          <span class="tv-ch" data-tv-ch aria-live="polite">CH 01 / {pad(channels.length)}</span>
          <button class="btn" type="button" data-tv-step="1" aria-label="Channel up">CH +</button>
        </div>
        <p class="tv-title" data-tv-title>{channels[0]?.title}</p>

        <div class="tv-deck" role="group" aria-label="Playback controls">
          <button class="btn sm" type="button" data-yt-play aria-label="Play">Play</button>
          <input class="rng seek" type="range" min="0" max="1000" value="0" step="1" data-yt-seek aria-label="Seek" />
          <span class="tv-time" data-yt-time>0:00 / 0:00</span>
          <button class="btn sm" type="button" data-yt-mute aria-label="Mute">Vol</button>
          <input class="rng vol" type="range" min="0" max="100" value="100" step="1" data-yt-vol aria-label="Volume" />
        </div>
      </div>

      <div class="tv-side">
        <h3>Channel guide</h3>
        <ul class="tv-guide" aria-label="Channels">
          {
            channels.map((c, i) => (
              <li>
                <button
                  class="btn sm"
                  type="button"
                  data-yt={c.youtube}
                  data-title={c.title}
                  aria-label={`Channel ${i + 1}: ${c.title}`}
                >
                  <span class="gn">{pad(i + 1)}</span>
                  <span class="gt">{c.title}</span>
                </button>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section class="pane" data-pane="contact" aria-labelledby="contact-h" hidden>
    <div class="split">
      <div class="text-screen">
        <p class="prompt">&gt; OPEN CHANNEL</p>
        <h2 id="contact-h">Contact</h2>
        <p class="lede">{site.contact.intro}</p>
        <ul class="links">
          {
            site.contact.links.map((l) => (
              <li>
                <a
                  href={l.href}
                  target={l.href.startsWith('mailto:') ? undefined : '_blank'}
                  rel="noopener noreferrer"
                >
                  <span>{l.label}</span>
                  {l.text}
                </a>
              </li>
            ))
          }
        </ul>
        <p class="prompt">&gt; <i class="cursor"></i></p>
      </div>
      <aside class="side">
        <ModelStage kind={site.contact.model.kind} tag={site.contact.model.tag} label={site.contact.model.label} file={site.contact.model.file} />
      </aside>
    </div>
  </section>
</Base>

<script>
  import '../scripts/router.ts';
  import '../scripts/swipe.ts';
  import '../scripts/models.ts';
  import '../scripts/menu.ts';
  import '../scripts/projects.ts';
  import '../scripts/tv.ts';
  import '../scripts/about.ts';
  import '../scripts/intro.ts';
</script>
