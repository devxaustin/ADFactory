---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects
    .filter((p) => !p.data.hidden)
    .map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const stageName = { prototype: 'Prototype', production: 'In production', shipped: 'Shipped' }[d.stage];
---

<Base title={`${d.title} | Austin Devereux Jr.`} description={d.summary} current="projects">
  <article class="doc" data-stage={d.stage}>
    <p class="prompt">&gt; <a href={`${base}#projects`}>BACK TO PROJECTS</a></p>

    <h1>{d.title}</h1>
    <span class="stage meta">{stageName}, {d.type}, {d.year}</span>
    <p class="summary">{d.summary}</p>

    {d.image && <img class="cover" src={`${base}${d.image.replace(/^\//, '')}`} alt="" />}

    <div class="body"><Content /></div>

    {
      d.links.length > 0 && (
        <ul class="links">
          {d.links.map((l) => (
            <li>
              <a class="btn" href={l.href} target="_blank" rel="noopener noreferrer">
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </article>
</Base>
